{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"$CLAUDE_PROJECT_DIR/.claude/hooks/jev_route.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"$CLAUDE_PROJECT_DIR/.claude/hooks/jev_done.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
